#!/usr/bin/env bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'
NC='\033[0m' # No Color

# Check for required commands
for cmd in curl mktemp bash; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo -e "${RED}Error:${NC} Required command '$cmd' not found. Please install it."
        exit 2
    fi
done

# Handle Ctrl+C gracefully
trap 'echo -e "\n${RED}Interrupted. Exiting.${NC}"; exit 130' SIGINT

# usage/help function
usage() {
    echo -e "${MAGENTA}$(basename "$0")${NC} - ${YELLOW}Bash-exercises Launcher Script${NC}"
    echo -e "${GREEN}USAGE:${NC} ${WHITE}$(basename "$0") [COMMAND] [OPTIONS]${NC}"
    echo -e "${GREEN}DESCRIPTION:${NC} Run project features:"
    echo -e "  ${YELLOW}•${NC} Extract shell aliases to Markdown, CSV, or HTML"
    echo -e "  ${YELLOW}•${NC} Recover stored passwords (coming soon)"
    echo -e "  ${YELLOW}•${NC} b6se —  CLI Utility"
    echo -e "${GREEN}COMMANDS:${NC}"
    echo -e "  ${MAGENTA}ea${NC}    Extract aliases (options: -o, -q, -h)"
    echo -e "  ${MAGENTA}rp${NC}    Recover passwords (not yet implemented)"
    echo -e "  ${MAGENTA}b6se${NC}  b6se —  CLI Utility (options: -h, --version, --serve, etc.)"
    echo -e "  ${RED}exit${NC}  Exit the script from interactive mode."
    echo -e "${GREEN}OPTIONS:${NC}"
    echo -e "  ${YELLOW}-h, --help${NC}   Show this help message and exit"
    echo -e "${GREEN}EXAMPLES:${NC}"
    echo -e "  ${WHITE}$(basename "$0") ea --help${NC}"
    echo -e "  ${WHITE}$(basename "$0") rp --help{NC}"
    echo -e "  ${WHITE}$(basename "$0") b6se --help${NC}"
    echo -e "  ${WHITE}$(basename "$0")${NC}"
    echo -e "For more details, see the README.md in each feature folder."
    echo -e "${CYAN}AUTHOR:${NC} Gabriel D. Vincent"
}

# Function to extract aliases
extract_aliases() {
    echo -e "\n${GREEN}Running extract_aliases.sh...${NC}"
    tmp=$(mktemp)
    curl -s -o "$tmp" https://raw.githubusercontent.com/Gabriel-Dakinah-Vincent/Bash-exercises/refs/heads/b6se_/Modules/Linmod/Bash/extract-aliases/src/extract_aliases.sh
    bash "$tmp" "$@"
    rm "$tmp"
    #curl -s https://raw.githubusercontent.com/Gabriel-Dakinah-Vincent/Bash-exercises/refs/heads/b6se_/Modules/Linmod/Bash/extract-aliases/src/extract_aliases.sh | bash -s -- "$@"
}

# Function to recover passwords (not implemented yet)
recover_passwords() {
    echo -e "\nYou chose to recover passwords."
    echo -e "${RED}This functionality is not yet implemented.${NC}"
    return 1
}

run_b6se() {
    echo -e "\n${GREEN}Running b6se.sh...${NC}"
    tmp=$(mktemp)
    curl -s -o "$tmp" https://raw.githubusercontent.com/Gabriel-Dakinah-Vincent/Bash-exercises/refs/heads/b6se_/Modules/Linmod/Bash/b6se/src/b6se.sh
    bash "$tmp" "$@"
    rm -f "$tmp"
    #curl -s https://raw.githubusercontent.com/Gabriel-Dakinah-Vincent/Bash-exercises/refs/heads/b6se_/Modules/Linmod/Bash/b6se/src/b6se.sh | bash -s -- "$@"
}

# Check if an argument is passed
case "$1" in
    ea)
        shift
        extract_aliases "$@"
        exit 0
        ;;
    rp)
        recover_passwords
        exit 0
        ;;
    b6se)
        shift
        run_b6se "$@"
        exit 0
        ;;    
    -h|--help)
        usage
        exit 0
        ;;
    exit)
        echo -e "\n${GREEN}Exiting the script. Goodbye!${NC}"
        exit 0
        ;;
    "" )
        # No argument, continue to interactive menu
        ;;
    *)
        echo -e "${RED}Error:${NC} Unknown command '$1'. Use -h for help."
        exit 1
        ;;
esac

finished=0

# Detect non-interactive shell without arguments
if ! [ -t 0 ]; then
    echo -e "\n${RED}\e[1mError\e[0m:${NC} Non-interactive shell detected. Please provide an argument."
    exit 1
fi

while [ $finished -ne 1 ]; do
    echo -e "\n${MAGENTA}Main Menu: What do you want to test?${NC}"
    echo -e "  1. ${GREEN}Extract Aliases${NC}: ${MAGENTA}ea${NC}"
    echo -e "  2. ${GREEN}Recover Passwords${NC}: ${MAGENTA}rp${NC}"
    #echo -e "  3. ${GREEN}Run b6se${NC}: ${MAGENTA}b6se${NC}"
    echo -e "  3. ${RED}Exit${NC}: ${RED}exit${NC}"
    prompt="${BLUE}Please enter your choice [${NC} ${MAGENTA}ea${NC} ${BLUE}/${NC} ${MAGENTA}rp${NC} ${BLUE}/${NC} ${RED}exit${NC} ${BLUE}]: ${NC}"
    read -p "$(echo -e "$prompt")" choice

    case $choice in
        ea)
            extract_aliases "$@"
            ;;
        rp)
            recover_passwords
            ;;
        #b6se)
        #    run_b6se "$@"
        #    ;;
        exit)
            finished=1
            echo -e "\n${GREEN}Exiting the script. Goodbye!${NC}"
            ;;
        *)
            echo -e "\n${RED}\e[1mError\e[0m:${NC} Invalid choice. Please enter: ${MAGENTA}ea${NC}, ${MAGENTA}rp${NC}, or ${RED}exit${NC}."
            ;;
    esac
done

echo -e "${GREEN}Thank you for using the script. Goodbye!${NC}"