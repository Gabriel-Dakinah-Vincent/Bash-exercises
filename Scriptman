#!/usr/bin/env bash

# Function to display help message.
show_help() {
    cat << EOF
NAME
    $(basename "$0") - A utility script.

SYNOPSIS
    $(basename "$0") COMMAND [OPTIONS]

DESCRIPTION
    A simple script that provides different functionalities:
        - Extract user-defined aliases from the system.
        - Recover stored passwords (not yet implemented).

COMMANDS
    ea
        Extract aliases by fetching and executing the extract_aliases.sh script.
        Options:
            -q
                Run in quiet mode (suppress non-essential output).
            -o <file>
                Write extracted aliases to the specified output file.

    rp
        Recover passwords (currently not implemented).

    exit
        Exit the script.

OPTIONS
    -h, --help
        Display this help message and exit.

EXAMPLES
    Run in direct mode:
        $(basename "$0") ea
        $(basename "$0") ea -q -o output.md
        $(basename "$0") rp

    Run in interactive mode:
        $(basename "$0")

AUTHOR
    Written by Gabriel D. Vincent
EOF
}

# Function to extract aliases
extract_aliases() {
    echo "You chose to extract aliases."
   curl -s https://raw.githubusercontent.com/Gabriel-Dakinah-Vincent/Bash-exercises/main/extract-aliases/src/extract_aliases.sh | bash -s -- "$@"

}

# Function to recover passwords (not implemented yet)
recover_passwords() {
    echo "You chose to recover passwords."
    echo "This functionality is not yet implemented."
}

# Check if an argument is passed
case "$1" in
    ea)
        shift
        extract_aliases "$@"
        exit 0
        ;;
    rp)
        recover_passwords
        exit 0
        ;;
   
    -h|--help)
        show_help
        exit 0
        ;;

    exit)
        echo "Exiting the script. Goodbye!"
        exit 0
        ;;
esac

finished=0

# Detect non-interactive shell without arguments
if ! [ -t 0 ]; then
    echo "Non-interactive shell detected. Please provide an argument."
    exit 1
fi

while [ $finished -ne 1 ]; do
    echo "What do you want to test?"
    echo "1. Extract Aliases: ea"
    echo "2. Recover Passwords: rp"
    echo "3. Exit: exit"
    read -p "Please enter your choice (ea/rp/exit): " choice

    case $choice in
        ea)
            extract_aliases "$@"
            ;;
        rp)
            recover_passwords
            ;;

        exit)
            finished=1
            echo "Exiting the script. Goodbye!"
            ;;
        *)
            echo "Invalid choice. Please enter 'ea', 'rp', or 'exit'."
            ;;
    esac
done

echo "Thank you for using the script. Goodbye!"