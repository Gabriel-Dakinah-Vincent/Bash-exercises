#!/bin/bash

# Function to extract aliases
extract_aliases() {
    echo "You chose to extract aliases."
   curl -s https://raw.githubusercontent.com/Gabriel-Dakinah-Vincent/Bash-exercises/main/extract-aliases/src/extract_aliases.sh | bash -s -- "$@"

}

# Function to recover passwords (not implemented yet)
recover_passwords() {
    echo "You chose to recover passwords."
    echo "This functionality is not yet implemented."
}

# Check if an argument is passed
if [ "$1" == "ea" ]; then
    extract_aliases
    exit 0
elif [ "$1" == "rp" ]; then
    recover_passwords
    exit 0
elif [ "$1" == "exit" ]; then
    echo "Exiting the script. Goodbye!"
    exit 0
fi

finished=0

while [ $finished -ne 1 ]; do
    echo "What do you want to test?"
    echo "1. Extract Aliases: ea"
    echo "2. Recover Passwords: rp"
    echo "3. Exit: exit"
    read -p "Please enter your choice (ea/rp/exit): " choice

    case $choice in
        ea)
            extract_aliases
            ;;
        rp)
            recover_passwords
            ;;
        exit)
            finished=1
            echo "Exiting the script. Goodbye!"
            ;;
        *)
            echo "Invalid choice. Please enter 'ea', 'rp', or 'exit'."
            ;;
    esac
done

echo "Thank you for using the script. Goodbye!"